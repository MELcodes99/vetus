# Required
SERV_API_KEY=            # from console.openserv.ai
TELEGRAM_BOT_TOKEN=      # from @BotFather

# Your Telegram user id. Only these ids can switch live payments on for a household (/enable CODE).
ADMIN_TELEGRAM_IDS=

# Public https address once deployed (enables Telegram webhook mode and dashboard links)
PUBLIC_URL=

# On a server only: base64 of your kpass login files, so Vetus can pay without a browser login.
#   base64 -i .kite-passport/config.json
#   base64 -i .kite-passport/agent.json
KPASS_CONFIG_B64=
KPASS_AGENT_B64=

# Optional
# SERV_MODEL=gpt-5.4-mini
# SERV_REASONING_EFFORT=medium
# WALLET_CHAIN=base
# DAILY_CHECK_LIMIT=30
# DRY_RUN=1                # vet everything, move no money
# VETUS_DATA=/var/data/vetus.json   # point at a persistent disk in production
